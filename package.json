{
  "name": "playwright-automation-framework",
  "version": "1.0.0",
  "description": "Generic reusable automation framework with Playwright and TypeScript",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:ui": "npx playwright test --ui",
    "test:visual": "npx playwright test tests/visual/",
    "test:visual:update": "npx playwright test tests/visual/ --update-snapshots",
    "report:html": "npx playwright show-report",
    "report:allure": "allure generate ./allure-results --clean -o ./allure-report && allure open ./allure-report"
  },
  "dependencies": {
    "@playwright/test": "^1.49.0",
    "allure-playwright": "^3.0.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
